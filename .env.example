# Flask
SECRET_KEY=change-me-in-production
FLASK_DEBUG=1
PORT=5000

# MySQL
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=arvind_gcc
MYSQL_USER=gcc_user
MYSQL_PASSWORD=gcc_pass
MYSQL_PORT=3306
APP_PORT=5000

# Local development (without Docker)
DATABASE_URL=mysql+pymysql://gcc_user:gcc_pass@localhost:3306/arvind_gcc

# Optional: alternate path to logo PNG (defaults to assets/arvind-gcc-logo.png)
# LOGO_SOURCE_PATH=C:\path\to\arvind-gcc-logo.png

# Microsoft Entra ID SSO (set AUTH_ENABLED=0 for local dev without login)
AUTH_ENABLED=1
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=https://faq.arvindgcc.com/auth/callback
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_HTTPONLY=1
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_HOURS=8

# Comma-separated emails allowed to view /admin/logs
LOG_ADMIN_EMAILS=admin@arvind.com
